# ── Required ──────────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-...

# ── Free tier (get at links below) ────────────────────────────────────────────
# https://api.stocktwits.com/developers/apps/new
STOCKTWITS_ACCESS_TOKEN=

# https://www.alphavantage.co/support/#api-key
ALPHA_VANTAGE_KEY=

# https://finnhub.io/register
FINNHUB_KEY=

# ── Paid (optional, unlocks higher-signal data) ───────────────────────────────
# https://polygon.io/dashboard/signup
POLYGON_KEY=

# https://financialmodelingprep.com/developer/docs
FMP_KEY=

# ── Tuning ────────────────────────────────────────────────────────────────────
# claude-sonnet-4-6 (faster/cheaper) or claude-opus-4-7 (deeper analysis)
CLAUDE_MODEL=claude-sonnet-4-6

# Seconds to sleep between stock analyses (respect API rate limits)
RATE_LIMIT_DELAY=2
